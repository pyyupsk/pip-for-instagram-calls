{
  "name": "pip-for-instagram-calls",
  "version": "1.0.0",
  "private": true,
  "description": "Picture in Picture (PiP) for Instagram video calls. Keep the video in a floating window while you use other tabs.",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "postinstall": "wxt prepare",
    "test": "bun test",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
