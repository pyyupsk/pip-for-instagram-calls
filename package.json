{
  "name": "pip-for-instagram-calls",
  "version": "1.0.1",
  "private": true,
  "description": "Picture in Picture (PiP) for Instagram video calls. Keep the video in a floating window while you use other tabs.",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "postinstall": "wxt prepare",
    "test": "bun test",
    "zip": "wxt zip"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
